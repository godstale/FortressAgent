{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Fortress — Midnight Rampart",
  "version": "1.0.0",
  "fonts": {
    "sans": ["Geist Variable", "IBM Plex Sans KR", "system-ui", "sans-serif"],
    "mono": ["JetBrains Mono Variable", "ui-monospace", "SFMono-Regular", "Consolas", "monospace"]
  },
  "radius": { "base": "0.5rem", "md": "calc(0.5rem - 2px)", "sm": "calc(0.5rem - 4px)", "card": "0.75rem" },
  "scales": {
    "primary":   { "50": "#EEF4FF", "100": "#D9E6FF", "200": "#B3CCFF", "300": "#85AEFF", "400": "#4D8FFF", "500": "#0476FF", "600": "#0062DB", "700": "#004FB3", "800": "#003C8A", "900": "#002A61", "950": "#00173A" },
    "secondary": { "50": "#EFF1FC", "100": "#DDE2F8", "200": "#BBC5F1", "300": "#97A6E8", "400": "#7688DE", "500": "#596FD5", "600": "#4357BE", "700": "#34449A", "800": "#283475", "900": "#1C2452", "950": "#10152F" },
    "tertiary":  { "50": "#FBEFFC", "100": "#F5DCF7", "200": "#EBB8EE", "300": "#DE92E3", "400": "#C573CB", "500": "#A958AF", "600": "#8E4394", "700": "#723477", "800": "#57275B", "900": "#3C1B3F", "950": "#231025" },
    "neutral":   { "50": "#F5F6FB", "100": "#E9EBF4", "200": "#D3D7E8", "300": "#B3B9D2", "400": "#8E95B6", "500": "#6D759E", "600": "#565D84", "700": "#434969", "800": "#2C3150", "900": "#1A1F3A", "950": "#0B1026" }
  },
  "themes": {
