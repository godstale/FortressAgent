      "tertiary": "#8E4394", "tertiary-foreground": "#FFFFFF",
      "border": "#D3D8E8", "input": "#D3D8E8", "ring": "#0062DB",
      "code": "#111733", "code-foreground": "#E8EBFA",
      "chart-1": "#0062DB", "chart-2": "#A958AF", "chart-3": "#0F8F5A", "chart-4": "#D08A1A", "chart-5": "#596FD5",
      "sidebar": "#FFFFFF", "sidebar-foreground": "#0E1330",
      "sidebar-primary": "#0062DB", "sidebar-primary-foreground": "#FFFFFF",
      "sidebar-accent": "#E3E7F2", "sidebar-accent-foreground": "#0E1330",
