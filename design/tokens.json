      "sidebar": "#111733", "sidebar-foreground": "#E8EBFA",
      "sidebar-primary": "#5B9BFF", "sidebar-primary-foreground": "#04122E",
      "sidebar-accent": "#212A55", "sidebar-accent-foreground": "#E8EBFA",
      "sidebar-border": "#2A3360", "sidebar-ring": "#8AB6FF"
