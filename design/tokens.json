      "card": "#111733", "card-foreground": "#E8EBFA",
      "popover": "#182044", "popover-foreground": "#E8EBFA",
      "primary": "#5B9BFF", "primary-foreground": "#04122E",
      "secondary": "#212A55", "secondary-foreground": "#E8EBFA",
      "muted": "#182044", "muted-foreground": "#A6ADCF",
      "subtle-foreground": "#8189B0",
      "accent": "#212A55", "accent-foreground": "#E8EBFA",
      "destructive": "#FF8A80", "destructive-foreground": "#2A0605",
      "success": "#4FD39A", "success-foreground": "#03261A",
      "warning": "#FFC062", "warning-foreground": "#2A1A00",
      "info": "#A3B0EC", "info-foreground": "#10152F",
